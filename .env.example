# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# AI Provider Configuration (server-side only — do NOT add NEXT_PUBLIC_ here)
# Free options:  groq | openrouter | mistral | nova     (paid: openai)
#   groq       → key at https://console.groq.com/keys      (fastest; ~1,000 req/day)
#   openrouter → key at https://openrouter.ai/keys          (:free models, 50 req/day)
#   mistral    → key at https://console.mistral.ai           (Codestral, free-plan credits)
#   nova       → SourceAI's own AI on this computer (http://127.0.0.1:8077);
#                grab a key from Nova's console: http://127.0.0.1:8077/apikey
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
# AI_PROVIDER=nova needs the key above, and usually nothing else:
#   AI_MODEL=nova   (default — or any cloud model id from Nova's 🧠 switch)
# Only used when AI_PROVIDER=custom (any OpenAI-compatible endpoint):
# AI_BASE_URL=

# Guardrails — protect the AI key if this app is ever exposed publicly
#   AI_REQUIRE_AUTH=1 makes the AI routes signed-in-only (Firebase ID tokens
#   are verified server-side). Leave 0 for local development.
AI_REQUIRE_AUTH=0
# Per-IP request budget for the AI routes (requests per minute):
AI_RATE_LIMIT_PER_MINUTE=30
# Reject AI request bodies larger than this (KB):
AI_MAX_BODY_KB=1024
# Hard cap for client-requested output length (tokens):
AI_MAX_OUTPUT_TOKENS=4096

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FREE_CONVERSATION_LIMIT=10
NEXT_PUBLIC_FREE_DAILY_REQUEST_LIMIT=50

# Upload Limits
MAX_UPLOAD_SIZE_MB=100
MAX_FILES_PER_PROJECT=500

# Conversion Limits
MAX_REPAIR_ATTEMPTS=5
MAX_CONVERSION_TIME_MINUTES=30
